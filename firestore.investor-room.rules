rules_version = '2';
// Firestore database "investor-room" in taliferro-de66f. Only the investorRoom
// function (Admin SDK) and functions/admin.js read or write it; no browser access.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
